<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_etiqueta_tree" model="ir.ui.view">
        <field name="name">jcd_tareas.etiqueta.tree</field>
        <field name="model">jcd_tareas.etiqueta</field>
        <field name="arch" type="xml">
            <tree string="Etiquetas" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="action_etiqueta" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">jcd_tareas.etiqueta</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
