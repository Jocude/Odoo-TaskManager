<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario -->
    <record id="view_tarea_form" model="ir.ui.view">
        <field name="name">jcd_tareas.tarea.form</field>
        <field name="model">jcd_tareas.tarea</field>
        <field name="arch" type="xml">
            <form string="Tarea">
                <header>
                    <button name="action_iniciar" type="object" string="Empezar" class="btn-primary"
                            invisible="estado != 'pendiente'"/>
                    <button name="action_finalizar" type="object" string="Finalizar" class="btn-primary"
                            invisible="estado != 'en_progreso' or bloqueada"/>
                    <button name="action_reabrir" type="object" string="Reabrir"
                            invisible="estado != 'finalizada'"/>
                    <field name="estado" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not bloqueada">
                    Esta tarea está <strong>bloqueada</strong>: depende de tareas que aún no se han finalizado.
                </div>
                <div class="alert alert-danger mb-0" role="alert" invisible="not retrasada">
                    Esta tarea está <strong>retrasada</strong>: ha pasado su fecha de fin estimada.
                </div>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="bloqueada" invisible="1"/>
                    <field name="retrasada" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nombre de la tarea"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="prioridad" widget="priority"/>
                            <field name="proyecto_id"/>
                            <field name="responsable_id" widget="many2one_avatar_user"/>
                            <field name="etiqueta_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin_estimada"/>
                            <field name="fecha_real_fin" invisible="not fecha_real_fin"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tiempo">
                            <field name="horas_estimadas" widget="float_time"/>
                            <field name="horas_dedicadas" widget="float_time"/>
                            <field name="progreso" widget="progressbar" invisible="not horas_estimadas"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción" name="descripcion">
                            <field name="descripcion" placeholder="¿En qué consiste la tarea?"/>
                        </page>
                        <page string="Registro de tiempo" name="tiempo">
                            <field name="registro_ids">
                                <tree editable="bottom">
                                    <field name="fecha"/>
                                    <field name="usuario_id" widget="many2one_avatar_user"/>
                                    <field name="descripcion"/>
                                    <field name="horas" widget="float_time" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Dependencias" name="dependencias">
                            <group>
                                <field name="depende_de_ids" widget="many2many_tags"
                                       domain="[('id', '!=', id)]"/>
                                <field name="bloquea_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </page>
                        <page string="Comentarios" name="comentarios">
                            <field name="comentario_ids">
                                <tree editable="top">
                                    <field name="fecha"/>
                                    <field name="autor_id" widget="many2one_avatar_user"/>
                                    <field name="comentario"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="notas" placeholder="Notas rápidas sobre la tarea"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Lista -->
    <record id="view_tarea_tree" model="ir.ui.view">
        <field name="name">jcd_tareas.tarea.tree</field>
        <field name="model">jcd_tareas.tarea</field>
        <field name="arch" type="xml">
            <tree string="Tareas" decoration-danger="retrasada" decoration-muted="estado == 'finalizada'">
                <field name="prioridad" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="proyecto_id"/>
                <field name="responsable_id" widget="many2one_avatar_user"/>
                <field name="etiqueta_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="fecha_fin_estimada"/>
                <field name="horas_dedicadas" widget="float_time" sum="Total" optional="show"/>
                <field name="progreso" widget="progressbar" optional="hide"/>
                <field name="estado" widget="badge"
                       decoration-info="estado == 'pendiente'"
                       decoration-warning="estado == 'en_progreso'"
                       decoration-success="estado == 'finalizada'"/>
                <field name="retrasada" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Kanban -->
    <record id="view_tarea_kanban" model="ir.ui.view">
        <field name="name">jcd_tareas.tarea.kanban</field>
        <field name="model">jcd_tareas.tarea</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" class="o_kanban_small_column" quick_create="false" sample="1">
                <field name="color"/>
                <field name="retrasada"/>
                <field name="bloqueada"/>
                <field name="horas_estimadas"/>
                <progressbar field="estado"
                             colors='{"pendiente": "info", "en_progreso": "warning", "finalizada": "success"}'/>
                <templates>
                    <t t-name="kanban-menu">
                        <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">Editar</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Eliminar</a>
                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                    </t>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{kanban_color(record.color.raw_value)}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-1">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                        <div class="text-muted small"><field name="proyecto_id"/></div>
                                    </div>
                                </div>
                                <field name="etiqueta_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                <div class="mt-1 small">
                                    <span t-if="record.bloqueada.raw_value" class="badge text-bg-warning me-1">
                                        <i class="fa fa-lock" title="Bloqueada"/> Bloqueada
                                    </span>
                                    <span t-if="record.retrasada.raw_value" class="badge text-bg-danger">
                                        <i class="fa fa-clock-o" title="Retrasada"/> Retrasada
                                    </span>
                                </div>
                                <div t-if="record.horas_estimadas.raw_value" class="mt-2">
                                    <field name="progreso" widget="progressbar"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="prioridad" widget="priority"/>
                                        <span t-attf-class="small ms-1 #{record.retrasada.raw_value ? 'text-danger fw-bold' : 'text-muted'}">
                                            <i class="fa fa-calendar" title="Fecha de fin estimada"/>
                                            <field name="fecha_fin_estimada"/>
                                        </span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="responsable_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendario -->
    <record id="view_tarea_calendar" model="ir.ui.view">
        <field name="name">jcd_tareas.tarea.calendar</field>
        <field name="model">jcd_tareas.tarea</field>
        <field name="arch" type="xml">
            <calendar string="Tareas" date_start="fecha_inicio" date_stop="fecha_fin_estimada"
                      color="proyecto_id" mode="month" quick_create="0" event_open_popup="1">
                <field name="responsable_id" avatar_field="avatar_128"/>
                <field name="estado"/>
            </calendar>
        </field>
    </record>

    <!-- Análisis -->
    <record id="view_tarea_graph" model="ir.ui.view">
        <field name="name">jcd_tareas.tarea.graph</field>
        <field name="model">jcd_tareas.tarea</field>
        <field name="arch" type="xml">
            <graph string="Tareas por proyecto" type="bar" stacked="1">
                <field name="proyecto_id"/>
                <field name="estado"/>
            </graph>
        </field>
    </record>

    <record id="view_tarea_pivot" model="ir.ui.view">
        <field name="name">jcd_tareas.tarea.pivot</field>
        <field name="model">jcd_tareas.tarea</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de tareas">
                <field name="proyecto_id" type="row"/>
                <field name="estado" type="col"/>
                <field name="horas_estimadas" type="measure" widget="float_time"/>
                <field name="horas_dedicadas" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <!-- Búsqueda -->
    <record id="view_tarea_search" model="ir.ui.view">
        <field name="name">jcd_tareas.tarea.search</field>
        <field name="model">jcd_tareas.tarea</field>
        <field name="arch" type="xml">
            <search string="Buscar tareas">
                <field name="name"/>
                <field name="proyecto_id"/>
                <field name="responsable_id"/>
                <field name="etiqueta_ids"/>
                <filter string="Mis tareas" name="mis_tareas" domain="[('responsable_id', '=', uid)]"/>
                <separator/>
                <filter string="Pendientes" name="pendientes" domain="[('estado', '=', 'pendiente')]"/>
                <filter string="En progreso" name="en_progreso" domain="[('estado', '=', 'en_progreso')]"/>
                <filter string="Sin finalizar" name="abiertas" domain="[('estado', '!=', 'finalizada')]"/>
                <separator/>
                <filter string="Retrasadas" name="retrasadas" domain="[('retrasada', '=', True)]"/>
                <filter string="Urgentes" name="urgentes" domain="[('prioridad', '=', '3')]"/>
                <separator/>
                <filter string="Archivadas" name="archivadas" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Proyecto" name="por_proyecto" context="{'group_by': 'proyecto_id'}"/>
                    <filter string="Estado" name="por_estado" context="{'group_by': 'estado'}"/>
                    <filter string="Responsable" name="por_responsable" context="{'group_by': 'responsable_id'}"/>
                    <filter string="Fecha de fin" name="por_fecha" context="{'group_by': 'fecha_fin_estimada'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acciones -->
    <record id="action_tarea" model="ir.actions.act_window">
        <field name="name">Tareas</field>
        <field name="res_model">jcd_tareas.tarea</field>
        <field name="view_mode">kanban,tree,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_tarea_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primera tarea</p>
            <p>Organiza el trabajo por proyectos, asigna responsables y registra las horas dedicadas.</p>
        </field>
    </record>

    <record id="action_mis_tareas" model="ir.actions.act_window">
        <field name="name">Mis tareas</field>
        <field name="res_model">jcd_tareas.tarea</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="view_tarea_search"/>
        <field name="context">{'search_default_mis_tareas': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tienes tareas asignadas</p>
        </field>
    </record>
</odoo>
