<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_jcd_tareas" model="ir.module.category">
        <field name="name">Tareas JCD</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_jcd_tareas_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_jcd_tareas"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_jcd_tareas_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_jcd_tareas"/>
        <field name="implied_ids" eval="[(4, ref('group_jcd_tareas_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Comentarios y partes de horas: cada usuario solo modifica o borra los suyos -->
    <record id="rule_comentario_propio" model="ir.rule">
        <field name="name">Comentarios: solo los propios se modifican o borran</field>
        <field name="model_id" ref="model_jcd_tareas_comentario"/>
        <field name="domain_force">[('autor_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_jcd_tareas_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_registro_propio" model="ir.rule">
        <field name="name">Registros de tiempo: solo los propios se crean, modifican o borran</field>
        <field name="model_id" ref="model_jcd_tareas_registro_tiempo"/>
        <field name="domain_force">[('usuario_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_jcd_tareas_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- El administrador puede con todo -->
    <record id="rule_comentario_manager" model="ir.rule">
        <field name="name">Comentarios: el administrador gestiona todos</field>
        <field name="model_id" ref="model_jcd_tareas_comentario"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_jcd_tareas_manager'))]"/>
    </record>

    <record id="rule_registro_manager" model="ir.rule">
        <field name="name">Registros de tiempo: el administrador gestiona todos</field>
        <field name="model_id" ref="model_jcd_tareas_registro_tiempo"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_jcd_tareas_manager'))]"/>
    </record>
</odoo>
