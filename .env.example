# Copia este fichero como .env y cambia los valores si quieres.
# Sin .env se usan los valores por defecto de docker-compose.yml (solo para desarrollo local).

# Base de datos
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# Odoo
ODOO_PORT=8069
ODOO_DB=tareas

# pgAdmin (solo con: docker compose --profile herramientas up -d)
PGADMIN_PORT=8080
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=cambiame
